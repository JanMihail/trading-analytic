    "panel-7": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "dfqtfblk2jnk0d"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.18.0",
                      "queryType": "timeseries",
                      "rawSql": "SELECT\r\n    toHour(timestamp) AS time,\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 0) AS \"0\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 2) AS \"2\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 4) AS \"4\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 6) AS \"6\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 8) AS \"8\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 10) AS \"10\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 12) AS \"12\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 14) AS \"14\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 16) AS \"16\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 18) AS \"18\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 20) AS \"20\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 22) AS \"22\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 24) AS \"24\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 26) AS \"26\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 28) AS \"28\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 30) AS \"30\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 32) AS \"32\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 34) AS \"34\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 36) AS \"36\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 38) AS \"38\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 40) AS \"40\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 42) AS \"42\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 44) AS \"44\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 46) AS \"46\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 48) AS \"48\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 50) AS \"50\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 52) AS \"52\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 54) AS \"54\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 56) AS \"56\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 58) AS \"58\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 60) AS \"60\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 62) AS \"62\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 64) AS \"64\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 66) AS \"66\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 68) AS \"68\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 70) AS \"70\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 72) AS \"72\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 74) AS \"74\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 76) AS \"76\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 78) AS \"78\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 80) AS \"80\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 82) AS \"82\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 84) AS \"84\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 86) AS \"86\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 88) AS \"88\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 90) AS \"90\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 92) AS \"92\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 94) AS \"94\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 96) AS \"96\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 = 98) AS \"98\",\r\n    countIf(floor((ask - bid) * 100000 / 2) * 2 >= 100) AS \"100\"\r\nFROM `tick_data`\r\nWHERE \r\n  name = '${instrument_name}'\r\n  AND $__timeFilter(timestamp)\r\nGROUP BY time\r\nORDER BY time ASC"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Что искать: Вы увидите зоны аномального расширения спреда (например, открытие Лондона/Нью-Йорка, выход новостей). Закономерность здесь: в какие часы ликвидность падает настолько, что торговать становится невыгодно, а в какие — рынок наиболее эффективен.",
