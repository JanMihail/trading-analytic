    "panel-6": {
      "kind": "Panel",
      "spec": {
        "data": {
          "kind": "QueryGroup",
          "spec": {
            "queries": [
              {
                "kind": "PanelQuery",
                "spec": {
                  "hidden": false,
                  "query": {
                    "datasource": {
                      "name": "dfqtfblk2jnk0d"
                    },
                    "group": "grafana-clickhouse-datasource",
                    "kind": "DataQuery",
                    "spec": {
                      "editorType": "sql",
                      "format": 0,
                      "meta": {
                        "builderOptions": {
                          "columns": [],
                          "database": "",
                          "limit": 1000,
                          "mode": "list",
                          "queryType": "table",
                          "table": ""
                        }
                      },
                      "pluginVersion": "4.18.0",
                      "queryType": "timeseries",
                      "rawSql": "WITH numbered_ticks AS (\r\n    SELECT\r\n        timestamp,\r\n        bid,\r\n        -- Нумеруем тики по порядку (начиная с 0 для удобства деления)\r\n        row_number() OVER (ORDER BY timestamp) - 1 AS tick_index\r\n    FROM `ticks_EURUSD`\r\n    -- Рекомендуется добавить фильтр по времени для ограничения выборки\r\n    WHERE $__timeFilter(timestamp)\r\n),\r\ngrouped_ticks AS (\r\n    SELECT\r\n        -- Группируем по 100 тиков (0-99, 100-199 и т.д.)\r\n        tick_index div 20 AS group_id,\r\n        bid,\r\n        -- Находим первую и последнюю цену в этой сотне тиков\r\n        first_value(bid) OVER (PARTITION BY group_id ORDER BY tick_index ASC) AS first_bid,\r\n        last_value(bid) OVER (PARTITION BY group_id ORDER BY tick_index ASC ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS last_bid,\r\n        -- Берем время начала и конца интервала\r\n        min(timestamp) OVER (PARTITION BY group_id) AS start_time,\r\n        max(timestamp) OVER (PARTITION BY group_id) AS end_time\r\n    FROM numbered_ticks\r\n)\r\nSELECT\r\n    group_id,\r\n    end_time,\r\n    start_time,\r\n    first_bid,\r\n    last_bid,\r\n    -- Вычисляем дельту в пунктах (делим на 0.00001 для перевода в пипсы)\r\n    round((last_bid - first_bid) / 0.00001, 1) AS bid_delta_pips\r\nFROM grouped_ticks\r\nGROUP BY group_id, start_time, end_time, first_bid, last_bid\r\nORDER BY group_id DESC;\r\n"
                    },
                    "version": "v0"
                  },
                  "refId": "A"
                }
              }
            ],
            "queryOptions": {},
            "transformations": []
          }
        },
        "description": "Что искать: Всплески «тиковой активности» часто опережают сильные ценовые движения. Если количество тиков резко растет, а цена не идет вверх — это признак лимитного барьера (крупный игрок удерживает уровень).",
        "id": 6,
        "links": [],
        "title": "Анализ микроструктуры рынка (Импульсы цены)",
        "vizConfig": {
          "group": "timeseries",
          "kind": "VizConfig",
